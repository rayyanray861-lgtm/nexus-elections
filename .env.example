PORT=3000
# For Supabase, paste the Session pooler URI from Project Dashboard > Connect.
# It should use port 5432 and include sslmode=require.
DATABASE_URL=
# For local PostgreSQL instead, leave DATABASE_URL blank and fill in these values:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexus_elections
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD
SESSION_SECRET=replace-this-with-a-long-random-secret
ADMIN_PASSWORD=nexus
